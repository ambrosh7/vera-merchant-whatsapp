# Team / metadata (must match README)
TEAM_NAME=Team Alpha
TEAM_MEMBERS=Ambrosh
CONTACT_EMAIL=team@example.com
BOT_VERSION=1.0.0

# LLM — Groq (openai/gpt-oss-120b or qwen/qwen3.6-27b)
LLM_PROVIDER=groq
LLM_API_KEY=
LLM_MODEL=openai/gpt-oss-120b

# Groq openai/gpt-oss-120b caps (client enforces with 85% headroom)
LLM_RPM=30
LLM_RPD=1000
LLM_TPM=8000
LLM_TPD=200000
LLM_LIMIT_HEADROOM=0.85
LLM_MAX_OUTPUT_TOKENS=900
LLM_REPAIR_MIN_TPM_REMAINING=2000
# Set to 1 when freezing submission.jsonl for bit-identical regen
COMPOSER_FORCE_DETERMINISTIC=0

# Runtime
HOST=0.0.0.0
PORT=8080
MAX_TICK_ACTIONS=3
TICK_DEADLINE_SECONDS=25
# Frozen with submission.jsonl — bump only when regenerating offline artifacts
COMPOSER_PROMPT_VERSION=composer_v1
